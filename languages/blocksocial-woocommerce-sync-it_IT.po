msgstr "Salva e applica a tutti i prodotti"

#: includes/class-wcis-view.php:202
msgid "Vorschau"
msgstr "Anteprima"

#: includes/class-wcis-view.php:203
msgid "Nur speichern"
msgstr "Salva soltanto"

#: includes/class-wcis-view.php:204
msgid "Originalpreise wiederherstellen"
msgstr "Ripristina prezzi originali"

#: includes/class-wcis-view.php:205 includes/views/admin-tabs.php:383
#: includes/views/partner-page.php:169 includes/views/settings-page.php:583
#: includes/views/settings-page.php:599 includes/views/settings-page.php:625
#: includes/views/settings-page.php:659 includes/views/settings-page.php:672
