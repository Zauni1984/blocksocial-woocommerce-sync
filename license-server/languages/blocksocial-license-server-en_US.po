msgid "BlockSocial Lizenzserver"
msgstr "BlockSocial License Server"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: blocksocial-license-server.php
msgid "https://blocksocial.eu"
msgstr "https://blocksocial.eu"

#. Description of the plugin
#: blocksocial-license-server.php
msgid ""
"Verkauf und Verwaltung von Plugin-Lizenzen über WooCommerce: Lizenzschlüssel"
" beim Kauf, Plätze (verbundene Shops) je Lizenzstufe, Verlängerung und "
"Upgrade im Kundenkonto, automatische Plugin-Updates für Lizenznehmer."
msgstr ""
"Sell and manage plugin licenses via WooCommerce: license keys on purchase, "
"seats (connected shops) per license tier, renewal and upgrade in the "
"customer account, automatic plugin updates for licensees."

#. Author of the plugin
